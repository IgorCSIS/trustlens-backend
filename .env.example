# Copy to .env and fill in. GITIGNORED, never committed.

# Etherscan V2 unified API key (works for Base via chainid). Same key you use
# to verify contracts. Get one free at https://etherscan.io/myapikey
BASESCAN_API_KEY=

# Anthropic API key for the M3 AI report layer. Get one at
# https://console.anthropic.com/settings/keys, this is the ONE key the server
# holds; users never need their own. Costs a few cents per deep scan.
ANTHROPIC_API_KEY=

# Optional: override the AI model. The code default is claude-sonnet-5.
# Uncomment one of these to trade cost against depth:
#   claude-opus-5     more capable on the hardest contracts, costs more per scan
#   claude-haiku-4-5  cheaper and faster, less thorough
# TRUSTLENS_MODEL=claude-opus-5
